# Cloudflare Pages reads this file at deploy time and serves the matching
# response headers. Static-site cache strategy: hash-named build artifacts
# (.css / .js / .woff2 / .svg) can be cached forever; HTML must revalidate
# quickly so an edition update visible within a minute, not a year.

# Long-lived static assets ----------------------------------------
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# HTML: short cache so updates propagate within minutes ---------
/
  Cache-Control: public, max-age=300, s-maxage=300
/*
  Cache-Control: public, max-age=300, s-maxage=300

# Baseline security headers --------------------------------------
/*
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: interest-cohort=()
