---
// One static page per edition: /edition/0001/, /edition/0002/, ...
// Layout mirrors design-system/ui_kits/web/edition.html — masthead +
// standfirst + numbered story rows + sources block + colophon.

import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const editions = await getCollection("editions");
  return editions.map((entry) => ({
    params: { issue_no: String(entry.data.issue_no).padStart(4, "0") },
    props: { edition: entry.data },
  }));
}

const { edition } = Astro.props;
const dateDisplay = edition.date.replace(/-/g, ".");
const issueNoDisplay = String(edition.issue_no).padStart(4, "0");
const storyCount = edition.articles.length;
const sourceCount = new Set(edition.articles.map((a) => a.source)).size;
---

<Layout title={`日々 · No. ${issueNoDisplay} — ${dateDisplay}`}>
  <header class="topbar">
    <div class="mark">日々</div>
    <nav>
      <a href="/">Archive</a>
      <a href="#" class="active">Today</a>
      <a href="#">Subscribe</a>
      <a href="#">About</a>
    </nav>
    <div class="right">NO. {issueNoDisplay} · {dateDisplay}</div>
  </header>

  <section class="edition-page">
    <div class="crumb">
      <a href="/" style="border-bottom:1px solid var(--text-primary);color:var(--text-primary)"
        >Archive</a
      >
      &nbsp;/&nbsp; No. {issueNoDisplay}
    </div>

    <div class="ehead">
      <div class="date-big">{dateDisplay}</div>
      <div class="meta">
        <strong>NO. {issueNoDisplay}</strong><br />
        {storyCount} STORIES · {sourceCount} SOURCES<br />
        {edition.daily_title && <span>{edition.daily_title}<br /></span>}
      </div>
    </div>

    {edition.standfirst && <p class="standfirst">{edition.standfirst}</p>}

    {
      edition.articles.map((article, i) => (
        <article class="story-web">
          <div class="num">{String(i + 1).padStart(2, "0")}</div>
          <div>
            <div class="meta">
              {article.category ?? "News"}
              {article.source_type && ` · ${article.source_type}`}
            </div>
            <h2>{article.title}</h2>
            {article.summary && <p>{article.summary}</p>}
          </div>
          <div class="right">
            Source<br />
            <a href={article.url} target="_blank" rel="noopener">
              {article.source} ↗
            </a>
          </div>
        </article>
      ))
    }

    {
      edition.sources_scanned && edition.sources_scanned.length > 0 && (
        <section class="sources-strip">
          <h3>Sources scanned this morning</h3>
          <ul>
            {edition.sources_scanned.map((s) => (
              <li>
                {s.name} <span class="kind">({s.kind})</span>{" "}
                {s.error ? <span class="error">error: {s.error}</span> : `${s.fetched_count} fetched`}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </section>
</Layout>
